# Optional local build tag. Compose builds these images locally.
TASKNEXUS_IMAGE_TAG=local
TASKNEXUS_DB_NAME=tasknexus

# Local authentication secrets. Use independently generated random values.
JWT_SECRET=
COOKIE_SECRET=
AGENT_BACKEND_SOCKET_TOKEN=
RABBITMQ_USERNAME=tasknexus
RABBITMQ_PASSWORD=
RABBITMQ_HOSTNAME=tasknexus-rabbitmq

# Airbyte runs in its own local Docker/kind cluster on port 8006.
AIRBYTE_WEB_URL=http://host.docker.internal:8006
AIRBYTE_API_URL=http://host.docker.internal:8006
AIRBYTE_RABBITMQ_HOST=host.docker.internal
WEBAPP_WEBHOOK_HOST=http://host.docker.internal:3000
FUNCTION_PROVIDER=local
MONGO_IMAGE=mongo:7.0
REDIS_IMAGE=redis:7-alpine
UNSTRUCTURED_IMAGE=quay.io/unstructured-io/unstructured-api:latest

# To reuse an existing installation's volumes, set these to its actual
# Docker volume names before starting TaskNexus. Leave blank for defaults.
TASKNEXUS_MONGO_VOLUME=
TASKNEXUS_REDIS_VOLUME=
TASKNEXUS_DATASOURCE_VOLUME=
TASKNEXUS_QDRANT_VOLUME=
TASKNEXUS_RABBITMQ_VOLUME=

URL_APP=http://localhost:3000
FROM_EMAIL_ADDRESS=noreply@example.com

# Configure your own accounts when enabling these optional integrations.
PROJECT_ID=
GCS_BUCKET_NAME=
GCS_BUCKET_NAME_PRIVATE=
GCS_BUCKET_LOCATION=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_ACCOUNT_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PLAN_PRICE_ID=
STRIPE_PRO_PLAN_PRICE_ID=
STRIPE_TEAMS_PLAN_PRICE_ID=
STRIPE_ADDON_USERS_PRICE_ID=
STRIPE_ADDON_STORAGE_PRICE_ID=
STRIPE_FREE_PLAN_PRODUCT_ID=
STRIPE_PRO_PLAN_PRODUCT_ID=
STRIPE_TEAMS_PLAN_PRODUCT_ID=
STRIPE_ADDON_USERS_PRODUCT_ID=
STRIPE_ADDON_STORAGE_PRODUCT_ID=

# Optional public product links. Empty values hide external links.
NEXT_PUBLIC_TASKNEXUS_WEBSITE_URL=
NEXT_PUBLIC_TASKNEXUS_DOCS_URL=
NEXT_PUBLIC_TASKNEXUS_TERMS_URL=
NEXT_PUBLIC_TASKNEXUS_PRIVACY_URL=
NEXT_PUBLIC_TASKNEXUS_SUPPORT_URL=
NEXT_PUBLIC_TASKNEXUS_SOURCE_URL=
NEXT_PUBLIC_TASKNEXUS_COMMUNITY_URL=
NEXT_PUBLIC_TASKNEXUS_LINKEDIN_URL=
NEXT_PUBLIC_TASKNEXUS_YOUTUBE_URL=
NEXT_PUBLIC_TASKNEXUS_CONTACT_URL=
NEXT_PUBLIC_TASKNEXUS_MEETING_URL=
NEXT_PUBLIC_TASKNEXUS_STRUCTURED_OUTPUT_DOCS_URL=
NEXT_PUBLIC_PINECONE_INTEGRATION_ID=
NEXT_PUBLIC_TASKNEXUS_RESTRICT_EMBEDDINGS_TO_1536=false
