# First Stage: Build
FROM node:20 as builder

WORKDIR /app

# Copy package.json and package-lock.json for npm install
COPY package.json package-lock.json ./

# Install dependencies
RUN npm ci --only=production

# Copy the rest of your application code
COPY . .

# ARGs for environment variables that need to be passed at build time
ARG GOOGLE_KEYPATH
ARG NEXT_PUBLIC_SECRET_PROVIDER
ARG NEXT_PUBLIC_STORAGE_PROVIDER
ARG GOOGLE_APPLICATION_CREDENTIALS
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_GCS_BUCKET_NAME
ARG NEXT_PUBLIC_GCS_BUCKET_NAME_PRIVATE
ARG NEXT_PUBLIC_POSTHOG_KEY
ARG NEXT_PUBLIC_LOCAL_UNSTRUCTURED
ARG NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH
ARG NEXT_PUBLIC_ENABLE_GITHUB_OAUTH
ARG LOG_LEVEL
ARG NEXT_PUBLIC_TASKNEXUS_WEBSITE_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_DOCS_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_TERMS_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_PRIVACY_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_SUPPORT_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_SOURCE_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_COMMUNITY_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_LINKEDIN_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_YOUTUBE_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_CONTACT_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_MEETING_URL=""
ARG NEXT_PUBLIC_TASKNEXUS_STRUCTURED_OUTPUT_DOCS_URL=""
ARG NEXT_PUBLIC_PINECONE_INTEGRATION_ID=""
ARG NEXT_PUBLIC_TASKNEXUS_RESTRICT_EMBEDDINGS_TO_1536=false

# Set environment variables based on ARGs
# ENV NEXT_PUBLIC_SHORT_COMMIT_HASH=$SHORT_COMMIT_HASH
ENV NEXT_PUBLIC_POSTHOG_KEY=$NEXT_PUBLIC_POSTHOG_KEY
ENV NEXT_PUBLIC_NO_PAYMENT_REQUIRED=$NEXT_PUBLIC_NO_PAYMENT_REQUIRED
ENV NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=$NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH
ENV NEXT_PUBLIC_ENABLE_GITHUB_OAUTH=$NEXT_PUBLIC_ENABLE_GITHUB_OAUTH
ENV NEXT_PUBLIC_GCS_BUCKET_NAME=$NEXT_PUBLIC_GCS_BUCKET_NAME
ENV NEXT_PUBLIC_SECRET_PROVIDER=$NEXT_PUBLIC_SECRET_PROVIDER
ENV NEXT_PUBLIC_STORAGE_PROVIDER=$NEXT_PUBLIC_STORAGE_PROVIDER
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_GCS_BUCKET_NAME_PRIVATE=$NEXT_PUBLIC_GCS_BUCKET_NAME_PRIVATE
ENV NEXT_PUBLIC_LOCAL_UNSTRUCTURED=$NEXT_PUBLIC_LOCAL_UNSTRUCTURED
ENV LOG_LEVEL=$LOG_LEVEL
ENV NEXT_PUBLIC_TASKNEXUS_WEBSITE_URL=$NEXT_PUBLIC_TASKNEXUS_WEBSITE_URL
ENV NEXT_PUBLIC_TASKNEXUS_DOCS_URL=$NEXT_PUBLIC_TASKNEXUS_DOCS_URL
ENV NEXT_PUBLIC_TASKNEXUS_TERMS_URL=$NEXT_PUBLIC_TASKNEXUS_TERMS_URL
ENV NEXT_PUBLIC_TASKNEXUS_PRIVACY_URL=$NEXT_PUBLIC_TASKNEXUS_PRIVACY_URL
ENV NEXT_PUBLIC_TASKNEXUS_SUPPORT_URL=$NEXT_PUBLIC_TASKNEXUS_SUPPORT_URL
ENV NEXT_PUBLIC_TASKNEXUS_SOURCE_URL=$NEXT_PUBLIC_TASKNEXUS_SOURCE_URL
ENV NEXT_PUBLIC_TASKNEXUS_COMMUNITY_URL=$NEXT_PUBLIC_TASKNEXUS_COMMUNITY_URL
ENV NEXT_PUBLIC_TASKNEXUS_LINKEDIN_URL=$NEXT_PUBLIC_TASKNEXUS_LINKEDIN_URL
ENV NEXT_PUBLIC_TASKNEXUS_YOUTUBE_URL=$NEXT_PUBLIC_TASKNEXUS_YOUTUBE_URL
ENV NEXT_PUBLIC_TASKNEXUS_CONTACT_URL=$NEXT_PUBLIC_TASKNEXUS_CONTACT_URL
ENV NEXT_PUBLIC_TASKNEXUS_MEETING_URL=$NEXT_PUBLIC_TASKNEXUS_MEETING_URL
ENV NEXT_PUBLIC_TASKNEXUS_STRUCTURED_OUTPUT_DOCS_URL=$NEXT_PUBLIC_TASKNEXUS_STRUCTURED_OUTPUT_DOCS_URL
ENV NEXT_PUBLIC_PINECONE_INTEGRATION_ID=$NEXT_PUBLIC_PINECONE_INTEGRATION_ID
ENV NEXT_PUBLIC_TASKNEXUS_RESTRICT_EMBEDDINGS_TO_1536=$NEXT_PUBLIC_TASKNEXUS_RESTRICT_EMBEDDINGS_TO_1536

# Disable Next.js telemetry
RUN npx next telemetry disable

# Build the application
RUN npm run build

# Second Stage: Runtime
FROM node:20

ARG SHORT_COMMIT_HASH=""
LABEL org.opencontainers.image.title="TaskNexus Webapp" \
	org.opencontainers.image.description="TaskNexus web application and API for AI agents, workflows, and data sources." \
	org.opencontainers.image.vendor="TaskNexus" \
	org.opencontainers.image.version="1.12.0" \
	org.opencontainers.image.revision="${SHORT_COMMIT_HASH}"

WORKDIR /app

# Set NODE_ENV environment variable
ENV NODE_ENV production

COPY --from=builder /app ./

# Display the environment variables to verify
RUN echo "NEXT_PUBLIC_POSTHOG_KEY: ${NEXT_PUBLIC_POSTHOG_KEY}"
RUN echo "NEXT_PUBLIC_STORAGE_PROVIDER: ${NEXT_PUBLIC_STORAGE_PROVIDER}"

# Expose the port the app runs on
EXPOSE 3000

# Command to run your app
CMD ["npm", "run", "start"]
